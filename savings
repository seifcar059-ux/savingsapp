<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Savings Tracker</title>

<link rel="manifest" href="manifest.json">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
body {
  margin: 0;
  background: #0f172a;
  font-family: system-ui, sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

.app {
  width: 360px;
  background: white;
  border-radius: 22px;
  padding: 16px;
}

.card {
  background: #f8fafc;
  border-radius: 14px;
  padding: 12px;
  margin-bottom: 10px;
}

input, select, button {
  width: 100%;
  padding: 12px;
  margin-top: 6px;
  border-radius: 10px;
  border: 1px solid #cbd5e1;
}

button {
  background: #22c55e;
  color: white;
  border: none;
  font-weight: 600;
}

canvas {
  width: 100%;
}
</style>
</head>

<body>

<div class="app" id="lock">
  <div class="card">
    <h3>🔒 Enter PIN</h3>
    <input type="password" id="pinInput" placeholder="4-digit PIN">
    <button onclick="unlock()">Unlock</button>
  </div>
</div>

<div class="app" id="app" style="display:none">

<h3 style="text-align:center">💰 Savings Tracker</h3>

<div class="card">
  <select id="currency">
    <option value="$">$ USD</option>
    <option value="€">€ EUR</option>
    <option value="£">£ GBP</option>
  </select>
</div>

<div class="card">
  <input type="number" id="goal" placeholder="Set goal">
  <button onclick="setGoal()">Save Goal</button>
</div>

<div class="card">
  <input type="number" id="amount" placeholder="Amount saved">
  <button onclick="addEntry()">Add</button>
</div>

<div class="card">
  <strong>Total:</strong> <span id="cur"></span><span id="total">0</span><br>
  <strong>Goal:</strong> <span id="cur2"></span><span id="goalView">0</span>
</div>

<div class="card">
  <canvas id="chart"></canvas>
</div>

<button onclick="exportCSV()">Export to Excel</button>

</div>

<script>
let data = JSON.parse(localStorage.getItem("data")) || [];
let goal = Number(localStorage.getItem("goal")) || 0;
let pin = localStorage.getItem("pin") || "1234";

if (!localStorage.getItem("pin")) localStorage.setItem("pin", "1234");

function unlock() {
  if (pinInput.value === pin) {
    lock.style.display = "none";
    app.style.display = "block";
    update();
  }
}

function setGoal() {
  goal = Number(goalInput.value);
  localStorage.setItem("goal", goal);
  update();
}

function addEntry() {
  data.push({
    amount: Number(amount.value),
    date: new Date().toLocaleDateString()
  });
  localStorage.setItem("data", JSON.stringify(data));
  update();
}

function update() {
  let total = data.reduce((s,e)=>s+e.amount,0);
  totalEl.textContent = total;
  goalView.textContent = goal;
  cur.textContent = currency.value;
  cur2.textContent = currency.value;
  drawChart();
}

function drawChart() {
  new Chart(chart, {
    type: 'line',
    data: {
      labels: data.map(e=>e.date),
      datasets: [{
        label: 'Savings',
        data: data.map(e=>e.amount),
        borderWidth: 2
      }]
    }
  });
}

function exportCSV() {
  let csv = "Date,Amount\n" + data.map(e=>`${e.date},${e.amount}`).join("\n");
  let blob = new Blob([csv], { type:"text/csv" });
  let a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "savings.csv";
  a.click();
}

const goalInput = document.getElementById("goal");
const amount = document.getElementById("amount");
const totalEl = document.getElementById("total");
const goalView = document my.getElementById("goalView");
const currency = document.getElementById("currency");
const cur = document.getElementById("cur");
const cur2 = document.getElementById("cur2");

</script>
</body>
</html>
<script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-app.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.0/firebase-firestore.js"></script>
